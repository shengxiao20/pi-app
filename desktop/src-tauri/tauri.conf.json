{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi App",
  "version": "0.1.0",
  "identifier": "app.pi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @pi-app/desktop",
    "beforeBuildCommand": "npm run build --workspace @pi-app/desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi App",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
