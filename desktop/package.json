{
  "name": "@pi-app/web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/index.ts --dev",
    "start": "node server-build/index.js --production",
    "build": "tsc --noEmit && vite build && node build-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.4",
    "@ag-ui/core": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "katex": "^0.19.0",
    "mermaid": "^11.17.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  }
}
