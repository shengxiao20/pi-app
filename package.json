{
  "name": "pi-native-app",
  "version": "0.1.15",
  "description": "AG-UI web client for Pi, backed by the native Pi TypeScript SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shengxiao20/pi-app.git"
  },
  "bugs": {
    "url": "https://github.com/shengxiao20/pi-app/issues"
  },
  "homepage": "https://github.com/shengxiao20/pi-app#readme",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "web",
    "ag-ui"
  ],
  "workspaces": [
    "desktop"
  ],
  "files": [
    "desktop/dist",
    "desktop/server/agui-adapter.ts",
    "desktop/server/app-store.ts",
    "desktop/server/clipboard-images.ts",
    "desktop/server/extension-feedback.ts",
    "desktop/server/index.ts",
    "desktop/server/session-registry.ts",
    "desktop/shared/extension-feedback.ts",
    "extensions",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "scripts": {
    "test": "npm run test --workspace @pi-app/web",
    "build": "npm run build --workspace @pi-app/web",
    "dev": "node --experimental-strip-types desktop/server/index.ts",
    "start": "NODE_ENV=production node --experimental-strip-types desktop/server/index.ts",
    "lint": "npm run lint --workspace @pi-app/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @pi-app/web",
    "format": "prettier --write extensions package.json tsconfig.json README.md && npm run format --workspace @pi-app/web",
    "format:check": "prettier --check extensions package.json tsconfig.json README.md && npm run format:check --workspace @pi-app/web",
    "prepack": "npm run build"
  }
}
